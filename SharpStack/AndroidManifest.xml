<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.Step95.SharpStack" android:versionCode="3" android:versionName="1.0.2">
	<uses-feature android:glEsVersion="0x00020000" android:required="true" />
	<!-- Required for Advertising ID on Android 13+ when app declares ads usage in Play Console -->
	<uses-permission android:name="com.google.android.gms.permission.AD_ID" />
	<application android:label="SharpStack" android:theme="@android:style/Theme.NoTitleBar.Fullscreen" android:icon="@drawable/icon">
		<!-- Use AdMob App ID. For testing use the sample ID below. Replace with your real App ID for production. -->
		<meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${ADMOB_APP_ID}" />
		<meta-data android:name="ADMOB_BANNER_ID" android:value="${ADMOB_BANNER_ID}" />
	</application>
</manifest>