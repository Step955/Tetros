<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Secrets.props" Condition="Exists('Secrets.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.Step95.SharpStack</ApplicationId>
	<Version>1.0.0</Version>
	<AndroidVersionCode>100200</AndroidVersionCode>
	<AndroidVersionName>1.0.0</AndroidVersionName>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidEnableJetifier>true</AndroidEnableJetifier>
    <AndroidEnableDesugar>true</AndroidEnableDesugar>
    <!-- Define GOOGLE_ADS to enable AdMob integration in Activity1.cs -->
    <DefineConstants>$(DefineConstants);GOOGLE_ADS</DefineConstants>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <AndroidKeyStore>False</AndroidKeyStore>
    <EmbedAssembliesIntoApk>False</EmbedAssembliesIntoApk>
	<DebugSymbols>true</DebugSymbols>
	<AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
  </PropertyGroup>

  <!-- Default AdMob IDs per configuration. Debug uses official Google test IDs. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AdMobAppId>ca-app-pub-3940256099942544~3347511713</AdMobAppId>
    <AdMobBannerId>ca-app-pub-3940256099942544/6300978111</AdMobBannerId>
  </PropertyGroup>

  <!-- Release configuration: values should be provided via Secrets.props, environment variables, or MSBuild properties. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Prefer values from Secrets.props or MSBuild properties; fallback to environment variables ADMOB_APP_ID / ADMOB_BANNER_ID -->
    <AdMobAppId>$(AdMobAppId)</AdMobAppId>
    <AdMobBannerId>$(AdMobBannerId)</AdMobBannerId>
    <AdMobAppId Condition="'$(AdMobAppId)' == ''">$([System.Environment]::GetEnvironmentVariable('ADMOB_APP_ID'))</AdMobAppId>
    <AdMobBannerId Condition="'$(AdMobBannerId)' == ''">$([System.Environment]::GetEnvironmentVariable('ADMOB_BANNER_ID'))</AdMobBannerId>
  </PropertyGroup>

  <!-- Pass AdMob IDs into Android manifest via placeholders -->
  <PropertyGroup>
    <AndroidManifestPlaceholders>ADMOB_APP_ID=$(AdMobAppId);ADMOB_BANNER_ID=$(AdMobBannerId)</AndroidManifestPlaceholders>
  </PropertyGroup>
	
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <AndroidKeyStore>True</AndroidKeyStore>
	 <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
	<AndroidSigningKeyStore>C:\SigningKeyVaults\sharpstack-upload.keystore</AndroidSigningKeyStore>
	<AndroidSigningKeyAlias>sharpstack</AndroidSigningKeyAlias>
	<AndroidSigningKeyPass>$(ANDROID_KEY_PASS)</AndroidSigningKeyPass>
	<AndroidSigningStorePass>$(ANDROID_STORE_PASS)</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.*" />
    <PackageReference Include="MonoGame.Framework.Android" Version="3.8.*" />
    <PackageReference Include="Xamarin.Google.UserMessagingPlatform" Version="4.0.0.4" />
    <!-- Google Play services Ads (AdMob) -->
    <PackageReference Include="Xamarin.GooglePlayServices.Ads" Version="125.4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Update="Resources\Drawable\Icon.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Content\controll_buttons.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- Secrets.props is gitignored but can be present locally to supply real IDs -->
    <None Update="Secrets.props">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
    <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>

  
</Project>
